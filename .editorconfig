# Formato común del proyecto. Que lo respeten todos los editores evita
# diferencias de espaciado en los commits que no significan nada.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 140

[*.{kt,kts,java}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# En Markdown, dos espacios al final de línea son un salto de línea.
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
