rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberOfGroup() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function notificationGroup() {
      return get(/databases/$(database)/documents/groups/$(request.resource.data.groupId));
    }

    function canCreateNotificationFor(userId) {
      return signedIn()
        && request.resource.data.userId == userId
        && request.resource.data.groupId is string
        && request.resource.data.fromUserId == request.auth.uid
        && request.auth.uid in notificationGroup().data.memberIds
        && userId in notificationGroup().data.memberIds;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow read, delete: if memberOfGroup();
      allow update: if memberOfGroup() && request.auth.uid in request.resource.data.memberIds;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownUser(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if ownUser(userId);
        allow create: if ownUser(userId) || canCreateNotificationFor(userId);
      }
    }
  }
}