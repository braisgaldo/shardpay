rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberOfGroup() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function canPreviewInvite() {
      return signedIn() && request.query.limit != null && request.query.limit <= 1;
    }

    function joiningGroupByInvite() {
      return signedIn()
        && !memberOfGroup()
        && resource.data.isClosed == false
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.pendingMembers.size() >= resource.data.pendingMembers.size() - 1
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.joinPin == resource.data.joinPin
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'members',
          'pendingMembers',
          'updatedAt',
        ]);
    }

    function notificationGroup() {
      return get(/databases/$(database)/documents/groups/$(request.resource.data.groupId));
    }

    function canCreateNotificationFor(userId) {
      return signedIn()
        && request.resource.data.userId == userId
        && request.resource.data.groupId is string
        && request.resource.data.fromUserId == request.auth.uid
        && request.auth.uid in notificationGroup().data.memberIds
        && userId in notificationGroup().data.memberIds;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow get: if memberOfGroup() || signedIn();
      allow list: if memberOfGroup() || canPreviewInvite();
      allow delete: if memberOfGroup();
      allow update: if (memberOfGroup() && request.auth.uid in request.resource.data.memberIds) || joiningGroupByInvite();
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownUser(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if ownUser(userId);
        allow create: if ownUser(userId) || canCreateNotificationFor(userId);
      }
    }
  }
}